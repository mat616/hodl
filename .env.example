RPC_URL=https://api.mainnet-beta.solana.com
# Optional fallback RPC URL, used when the primary RPC returns 429.
RPC_FALLBACK=
# Program id from `anchor keys sync`.
PROGRAM_ID=
# Same program id, for the web dev server.
VITE_PROGRAM_ID=
# Comma-separated quote mints the page may approve.
VITE_QUOTE_MINTS=
KEEPER_SEND=1
ORACLE_MODE=switchboard
KEEPER_INTERVAL_MS=20000
KEEPER_DEPOSIT_MINUTES=10
# Path to the vault-authority JSON keypair. Do not commit that file.
KEEPER_KEY_HOST=./keeper.json
# Rewards API base URL, with no trailing slash. Leave empty to skip polling.
REWARDS_API=
# Wallet that holds bought tokens. Base58 address, not a key file.
PRODUCTIVE_WALLET=
# Mint bought with the backing slice. Leave empty to skip that swap.
OUTPUT_MINT=
